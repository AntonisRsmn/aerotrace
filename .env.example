# Aircraft data mode: "live", "hybrid", or "demo".
# live = real aircraft only; hybrid = real aircraft plus simulated traffic; demo = simulated traffic only.
AEROTRACE_MODE=hybrid

# Number of simulated aircraft added in hybrid mode or shown in demo mode (100-3000).
DEMO_AIRCRAFT_COUNT=1000

# Optional OpenSky credentials used only in live mode.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_CLIENT_ID_BACKUP=
# OPENSKY_CLIENT_SECRET_BACKUP=
