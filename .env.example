# Aircraft data mode: "live", "hybrid", or "demo".
# live = live aircraft; hybrid = live aircraft plus historical replay; demo = historical recorded tracks replayed as demo traffic.
AEROTRACE_MODE=demo

# Maximum number of historical flight tracks shown in hybrid/demo mode (100-3000).
DEMO_AIRCRAFT_COUNT=1000

# Optional OpenSky credentials used only in live mode.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_CLIENT_ID_BACKUP=
# OPENSKY_CLIENT_SECRET_BACKUP=

# Optional Google Programmable Search fallback for aircraft photographs.
# Configure a Programmable Search Engine that can search the web, then add:
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
