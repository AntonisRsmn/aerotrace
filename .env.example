# Aircraft data mode: "demo" or "live" (dev is accepted as an alias for demo).
# Demo mode generates simulated data locally and never calls live aircraft providers.
AEROTRACE_MODE=demo

# Total simulated aircraft generated for the demo (100-3000).
DEMO_AIRCRAFT_COUNT=1000

# Optional OpenSky credentials used only in live mode.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_CLIENT_ID_BACKUP=
# OPENSKY_CLIENT_SECRET_BACKUP=
